msgid "plugins.generic.titlePageForPreprint.displayName"
msgstr "Title Page For Preprint"

msgid "plugins.generic.titlePageForPreprint.description"
msgstr "Add a title page with essential information about the preprint"

msgid "plugins.generic.titlePageForPreprint.publicationStatus"
msgstr "Publication status"

msgid "plugins.generic.titlePageForPreprint.emptyPublicationStatus"
msgstr "Not informed by the submitting author"

msgid "plugins.generic.titlePageForPreprint.checklistLabel"
msgstr "This preprint was submitted under the following conditions"

msgid "plugins.generic.titlePageForPreprint.publicationDate"
msgstr "Posted on: {$postDate} (version {$version})"

msgid "plugins.generic.titlePageForPreprint.submissionDate"
msgstr "Submitted on: {$subDate}"

msgid "plugins.generic.titlePageForPreprint.endorsement"
msgstr ""
"The moderation of this preprint received the endorsement of:"

msgid "plugins.generic.titlePageForPreprint.endorserLine"
msgstr "{$endorserName} (ORCID: <a href=\"{$endorserOrcid}\">{$endorserOrcid}</a>)"

msgid "plugins.generic.titlePageForPreprint.citation"
msgstr ""
"How to cite this translation:"
"{$citation}"

msgid "plugins.generic.titlePageForPreprint.versionJustification"
msgstr "Version justification"

msgid "plugins.generic.titlePageForPreprint.headerText"
msgstr "LILACS Preprint - This document is a preprint and its current status is available at: {$doiPreprint}"

msgid "plugins.generic.titlePageForPreprint.dateFormat"
msgstr "(YYYY-MM-DD)"

msgid "plugins.generic.titlePageForPreprint.requirements.pdfManipulatorMissing"
msgstr "Title Page - This plugin requires the CPDF binary to be present at the /usr/local/bin directory of your server. This plugin won't execute its features until this binary is present. Please, contact your support team."

msgid "plugins.generic.titlePageForPreprint.requirements.pdfManipulatorNotExecutable"
msgstr "Title Page - This plugin requires the CPDF binary at the /usr/local/bin directory of your server being executable. This plugin won't execute its features until this binary is marked as executable. Please, contact your support team."

msgid "plugins.generic.titlePageForPreprint.requirements.removeTitlePageMissing"
msgstr "Title Page Remove Failure"

msgid "plugins.generic.titlePageForPreprint.requirements.generateTitlePageMissing"
msgstr "Title Page Generation Failure"

msgid "plugins.generic.titlePageForPreprint.requirements.generateChecklistPageMissing"
msgstr "Checklist Page Generation Failure"

msgid "plugins.generic.titlePageForPreprint.requirements.addDocumentHeaderMissing"
msgstr "Headers Stamping Failure"

msgid "plugins.generic.titlePageForPreprint.requirements.concatenateTitlePageMissing"
msgstr "Title Page Concatenation Failure"

msgid "plugins.generic.titlePageForPreprint.requirements.concatenateChecklistPageMissing"
msgstr "Checklist Page Concatenation Failure"

msgid "plugins.generic.titlePageForPreprint.cover.preprint"
msgstr "PREPRINT"

msgid "plugins.generic.titlePageForPreprint.cover.version"
msgstr "VERSION {$version}"

msgid "plugins.generic.titlePageForPreprint.cover.doi"
msgstr "DOI"

msgid "plugins.generic.titlePageForPreprint.cover.notPeerReviewed"
msgstr "This preprint has not been peer reviewed."

msgid "plugins.generic.titlePageForPreprint.cover.disclaimer"
msgstr "Its publication does not certify the scientific quality of the work, validate its conclusions or represent scientific endorsement by BIREME, PAHO or WHO."

msgid "plugins.generic.titlePageForPreprint.cover.submitted"
msgstr "SUBMITTED ON"

msgid "plugins.generic.titlePageForPreprint.cover.posted"
msgstr "POSTED ON"

msgid "plugins.generic.titlePageForPreprint.cover.postedValue"
msgstr "{$date} (version {$version})"

msgid "plugins.generic.titlePageForPreprint.cover.doiUnavailable"
msgstr "Not provided"

msgid "plugins.generic.titlePageForPreprint.cover.tooLong"
msgstr "The metadata exceeds the space available on one title page. The original PDF has been preserved."
