msgstr "Sua publicação não certifica a qualidade científica do trabalho, não valida suas conclusões e não representa endosso científico da BIREME, da OPAS ou da OMS."

msgid "plugins.generic.titlePageForPreprint.cover.submitted"
msgstr "SUBMETIDO EM"

msgid "plugins.generic.titlePageForPreprint.cover.posted"
msgstr "POSTADO EM"

msgid "plugins.generic.titlePageForPreprint.cover.postedValue"
msgstr "{$date} (versão {$version})"

msgid "plugins.generic.titlePageForPreprint.cover.doiUnavailable"
msgstr "Não informado"

msgid "plugins.generic.titlePageForPreprint.cover.tooLong"
msgstr "Os metadados excedem o espaço de uma folha de rosto. O PDF original foi preservado."
